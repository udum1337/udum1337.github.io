# Токен от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAHвставь_сюда_токен_от_BotFather

# Твой Telegram ID — сюда будут приходить заявки.
# Узнать: запусти бота и отправь ему /myid.
OWNER_ID=

# Локальный прокси VPN, если Telegram API заблокирован.
# Порт можно указать любой — при запуске бот сам найдёт рабочий
# (10809, 10801, 7890, 10808, 7891, 1080).
# Если Telegram доступен напрямую — строку можно удалить.
PROXY_URL=http://127.0.0.1:10809
